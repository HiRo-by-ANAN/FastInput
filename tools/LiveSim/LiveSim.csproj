  <ItemGroup><Compile Include="../../native/windows/Realtime/**/*.cs" Exclude="../../native/windows/Realtime/RealtimeRuntime.cs;../../native/windows/Realtime/RealtimeUi.cs" Link="Realtime/%(RecursiveDir)%(Filename)%(Extension)" /></ItemGroup>
